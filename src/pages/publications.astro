---
import BaseLayout from "../layouts/BaseLayout.astro";
import { PUBLICATIONS, METRICS, type Publication } from "../data/publications";

/** Escape HTML, then turn **name** into <strong>name</strong>. */
function formatAuthors(s: string): string {
  const esc = s
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");
  return esc.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
}

function link(p: Publication): string | undefined {
  if (p.doi) return `https://doi.org/${p.doi}`;
  return p.url;
}

// Group by year, newest first, preserving the order inside each year.
const byYear = new Map<number, Publication[]>();
for (const p of PUBLICATIONS) {
  if (!byYear.has(p.year)) byYear.set(p.year, []);
  byYear.get(p.year)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);

const journalCount = PUBLICATIONS.filter((p) => (p.kind ?? "article") === "article").length;
---

<BaseLayout
  title="Publications — Yu Zhang"
  description="Peer-reviewed publications in machine learning for drug discovery, quantitative systems pharmacology, and systems biology."
>
  <!-- Hero -->
  <section class="relative overflow-hidden rounded-3xl border border-zinc-200 shadow-sm dark:border-zinc-800">
    <div class="absolute inset-0 hero-panel"></div>

    <div class="relative p-8 sm:p-10 text-white">
      <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight">Publications</h1>
      <p class="mt-3 max-w-3xl text-white/85 leading-7">
        {journalCount} peer-reviewed papers in machine learning for drug discovery, quantitative
        systems pharmacology, and systems biology. Full list below.
      </p>

      <div class="mt-6 space-y-4">
        <!-- Featured: Cell 2025 -->
        <article class="rounded-2xl bg-white/10 p-5 ring-1 ring-white/15">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
            <div class="w-full sm:w-40 md:w-44 shrink-0">
              <img
                src="/img/featured/genai-antibiotics.jpg"
                alt="Generative antibiotic design"
                class="w-full h-36 sm:h-36 md:h-40 rounded-xl object-cover ring-1 ring-white/15"
                loading="lazy"
              />
            </div>

            <div class="min-w-0">
              <p class="text-base font-semibold">
                A generative deep learning approach to de novo antibiotic design
              </p>

              <p class="mt-2 text-sm text-white/80">
                <em>Cell</em> 188(21):5962–5979.e22, 2025 — Krishnan, A.; Anahtar, M. N.; Valeri, J. A.;
                … ; <strong>Zhang, Y.</strong>; … ; Collins, J. J.
              </p>

              <p class="mt-3 text-sm leading-6 text-white/80">
                Generative models paired with synthesis and whole-cell testing, applied to two
                priority Gram-negative pathogens.
              </p>

              <p class="mt-3 text-sm text-white/75">
                <a class="underline decoration-white/40 underline-offset-4 hover:decoration-white"
                   href="https://doi.org/10.1016/j.cell.2025.07.033" target="_blank" rel="noreferrer">Paper</a>
                <span class="px-1 text-white/40">·</span>
                Press:
                <a class="underline decoration-white/40 underline-offset-4 hover:decoration-white"
                   href="https://www.bbc.com/news/articles/cgr94xxye2lo" target="_blank" rel="noreferrer">BBC</a>,
                <a class="underline decoration-white/40 underline-offset-4 hover:decoration-white"
                   href="https://news.mit.edu/2025/using-generative-ai-researchers-design-compounds-kill-drug-resistant-bacteria-0814" target="_blank" rel="noreferrer">MIT News</a>,
                <a class="underline decoration-white/40 underline-offset-4 hover:decoration-white"
                   href="https://www.cnet.com/tech/services-and-software/generative-ai-gave-mit-scientists-a-new-tool-to-fight-antibiotic-resistant-bacteria/" target="_blank" rel="noreferrer">CNET</a>,
                <a class="underline decoration-white/40 underline-offset-4 hover:decoration-white"
                   href="https://spectrum.ieee.org/ai-drug-design-mit-antibiotics" target="_blank" rel="noreferrer">IEEE Spectrum</a>
              </p>
            </div>
          </div>
        </article>

        <!-- Featured: WIREs 2022 review -->
        <article class="rounded-2xl bg-white/10 p-5 ring-1 ring-white/15">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
            <div class="w-full sm:w-40 md:w-44 shrink-0">
              <img
                src="/img/featured/angiogenesis.jpg"
                alt="Systems biology of angiogenesis signaling"
                class="w-full h-36 sm:h-36 md:h-40 rounded-xl object-cover ring-1 ring-white/15"
                loading="lazy"
              />
            </div>

            <div class="min-w-0">
              <p class="text-base font-semibold">
                Systems biology of angiogenesis signaling: Computational models and omics
              </p>

              <p class="mt-2 text-sm text-white/80">
                <em>WIREs Mechanisms of Disease</em> 14(4):e1550, 2022 —
                <strong>Zhang, Y.</strong>; Wang, H.; Oliveira, R. H. M.; Zhao, C.; Popel, A. S.
              </p>

              <p class="mt-3 text-sm leading-6 text-white/80">
                First-author review of mechanistic and data-driven models of angiogenic signaling.
              </p>

              <p class="mt-3 text-sm text-white/75">
                <a class="underline decoration-white/40 underline-offset-4 hover:decoration-white"
                   href="https://doi.org/10.1002/wsbm.1550" target="_blank" rel="noreferrer">Paper</a>
                <span class="px-1 text-white/40">·</span>
                Press:
                <a class="underline decoration-white/40 underline-offset-4 hover:decoration-white"
                   href="https://www.advancedsciencenews.com/decoding-the-language-of-cells-with-virtual-modeling/" target="_blank" rel="noreferrer">
                  <em>Advanced Science News</em>
                </a>
              </p>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Metrics -->
  <section class="mt-10">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h2 class="text-lg font-semibold tracking-tight">Metrics</h2>
      <p class="text-sm text-zinc-500 dark:text-zinc-400">
        Google Scholar, {METRICS.asOf} —
        <a class="underline underline-offset-4 hover:text-zinc-900 dark:hover:text-white"
           href={METRICS.scholar} target="_blank" rel="noreferrer">live profile</a>
      </p>
    </div>
    <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
      {METRICS.items.map((s) => (
        <div class="rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm dark:border-zinc-800 dark:bg-zinc-900/40">
          <div class="text-2xl font-semibold tracking-tight">{s.value}</div>
          <div class="mt-1 text-sm text-zinc-600 dark:text-zinc-300">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- Full list -->
  <section class="mt-12">
    <h2 class="text-lg font-semibold tracking-tight">All publications</h2>

    {years.map((year) => (
      <div class="mt-8 first:mt-6">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
          {year}
        </h3>

        <ol class="mt-3 space-y-5 border-t border-zinc-200 pt-5 dark:border-zinc-800">
          {byYear.get(year)!.map((p) => (
            <li class="leading-6">
              <p class="font-medium text-zinc-900 dark:text-zinc-100">
                {link(p) ? (
                  <a
                    class="underline decoration-zinc-300 underline-offset-4 hover:decoration-zinc-900 dark:decoration-zinc-600 dark:hover:decoration-zinc-100"
                    href={link(p)}
                    target="_blank"
                    rel="noreferrer"
                  >
                    {p.title}
                  </a>
                ) : (
                  p.title
                )}
              </p>

              <p
                class="mt-1 text-sm text-zinc-600 dark:text-zinc-300"
                set:html={formatAuthors(p.authors)}
              />

              <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
                <em>{p.venue}</em>{p.volume ? ` ${p.volume}` : ""}{p.pages ? `:${p.pages}` : ""}
                {p.kind === "chapter" ? " · book chapter" : ""}
                {p.note ? (
                  <span class="ml-2 rounded-full border border-zinc-300 px-2 py-0.5 text-xs text-zinc-600 dark:border-zinc-700 dark:text-zinc-300">
                    {p.note}
                  </span>
                ) : null}
              </p>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </section>
</BaseLayout>
